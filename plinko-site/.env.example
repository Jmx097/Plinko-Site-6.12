NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
PLINKO_APP_URL=https://your-app.example.com
PLINKO_CORE_URL=https://your-plinko-solutions-core.supabase.co
PLINKO_CORE_SERVICE_ROLE_KEY=replace-with-server-only-key
PLINKO_CORE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Comma-separated staff email allowlist. Server-only; no browser prefix.
PLINKO_POCKET_ADMIN_EMAILS=admin@example.com,ops@example.com
# Shared admin CRM workspace. Values are server-only; never use NEXT_PUBLIC_ prefixes.
CRM_API_BASE_URL=https://crm-api.plinkosolutions.com
CRM_API_TOKEN=replace-with-server-only-crm-token
# Required for every CRM POST. Kept server-only; never use NEXT_PUBLIC_ prefixes.
CRM_ACTOR_SIGNING_SECRET=replace-with-a-long-random-server-only-secret
# Additional equal CRM admins; existing PLINKO_POCKET_ADMIN_EMAILS remain authorized.
PLINKO_CRM_EQUAL_ADMIN_EMAILS=crm-admin@example.com
# Server-only narrow bridge to the default-profile Hermes API. Never use NEXT_PUBLIC_ prefixes.
POCKET_HERMES_API_BASE_URL=https://hermes.example.com/pocket/v1
POCKET_HERMES_API_KEY=replace-with-dedicated-revocable-pocket-bridge-token
